# ─────────────────────────────────────────────────────────────────────────────
# AdaptiveLearn AI — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-string

# JWT algorithm (leave as HS256 unless you need asymmetric keys)
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — fine for single-server deployments)
DATABASE_URL=sqlite:////app/data/adaptive_learning.db

# PostgreSQL example (uncomment and fill in to switch):
# DATABASE_URL=postgresql://user:password@db:5432/adaptivelearn

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# For Docker Compose: http://localhost is sufficient (nginx is on port 80).
# For a cloud deployment, add your domain: https://myapp.example.com
ALLOWED_ORIGINS=http://localhost,http://localhost:80
